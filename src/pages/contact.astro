---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us">
  <div class="max-w-2xl mx-auto py-8">
    <h1 class="text-3xl font-black text-slate-900 mb-2">Get in Touch</h1>
    <p class="text-slate-600 text-sm mb-8">Questions about party rentals, event coverage, or local deals? Send us a message.</p>

    <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 text-sm">
      <div>
        <p class="font-bold text-slate-900">📍 Service Region</p>
        <p class="text-slate-600 mt-1">Las Vegas, Henderson, Summerlin & North Las Vegas, Nevada</p>
      </div>
      <div>
        <p class="font-bold text-slate-900">✉️ Email Inquiries</p>
        <p class="text-slate-600 mt-1">General & Rentals: contact@702o2.com</p>
        <p class="text-slate-600">Media & Press: media@702o2.com</p>
      </div>
      <div class="pt-4 border-t border-slate-100 flex gap-4">
        <a href="/party-rentals" class="text-xs font-bold text-rose-600 hover:underline">Party Setups →</a>
        <a href="/media" class="text-xs font-bold text-slate-900 hover:underline">Photography Packages →</a>
      </div>
    </div>
  </div>
</Layout>