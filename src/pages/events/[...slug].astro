---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

// Helper to remove GMT timestamp and format cleanly as "Sat, Aug 29, 2026"
function formatCleanDate(dateVal: any) {
  if (!dateVal) return '';
  const rawStr = String(dateVal).trim();
  // Check if string contains standard YYYY-MM-DD
  const match = rawStr.match(/(\d{4})-(\d{2})-(\d{2})/);
  if (match) {
    const [_, y, m, d] = match;
    const dateObj = new Date(Date.UTC(Number(y), Number(m) - 1, Number(d)));
    return dateObj.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC'
    });
  }
  const d = new Date(dateVal);
  if (!isNaN(d.getTime())) {
    return d.toLocaleDateString('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC'
    });
  }
  return rawStr;
}
---

<Layout title={`${event.data.title} | Vegas Events Calendar`}>
  <article class="max-w-4xl mx-auto py-8">
    <a href="/events" class="text-xs font-bold text-slate-500 hover:text-indigo-600 mb-6 inline-flex items-center gap-1">
      ← Back to Events Calendar
    </a>

    {event.data.image && (
      <div class="w-full rounded-3xl overflow-hidden bg-slate-100 mb-8 border border-slate-200">
        <img src={event.data.image} alt={event.data.title} class="w-full h-auto max-h-[500px] object-cover" />
      </div>
    )}

    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
        {event.data.category}
      </span>
      {event.data.admission && (
        <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          {event.data.admission}
        </span>
      )}
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 leading-tight mb-6">
      {event.data.title}
    </h1>

    <!-- Schedule Box (Clean Date & Close Left Alignment) -->
    <div class="bg-slate-100 p-6 rounded-2xl border border-slate-200 mb-8">
      <h2 class="text-xs font-black text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-1.5">
        <span>🗓️</span> Event Schedule & Timing
      </h2>
      
      <div class="space-y-3 text-xs text-slate-700 font-medium">
        {event.data.schedules && event.data.schedules.length > 0 ? (
          <div class="space-y-2.5">
            {event.data.schedules.map((sch: any) => {
              const cleanDate = formatCleanDate(sch.eventDate || sch.day);
              const timeDisplay = sch.startTime 
                ? (sch.endTime ? `${sch.startTime} – ${sch.endTime}` : sch.startTime)
                : (sch.time || sch.timeNote || '');
              
              return (
                <div class="flex flex-wrap items-center gap-2.5 py-1">
                  <span class="w-2 h-2 rounded-full bg-indigo-600 shrink-0"></span>
                  <span class="font-bold text-slate-900 text-sm">{cleanDate}</span>
                  {timeDisplay && (
                    <span class="text-slate-800 bg-white px-3 py-1 rounded-lg border border-slate-200 font-bold inline-flex items-center gap-1 shadow-2xs">
                      ⏰ {timeDisplay}
                    </span>
                  )}
                  {sch.label && (
                    <span class="text-[11px] font-semibold text-slate-500 italic">
                      ({sch.label})
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        ) : (
          <div class="flex items-center gap-2 text-slate-900 font-bold">
            <span>⏰</span> {event.data.legacyDate || event.data.eventDate || 'Check event description below'}
          </div>
        )}

        <div class="flex items-center gap-2 pt-3 border-t border-slate-200 text-slate-800">
          <span>📍</span> <strong>Venue:</strong> {event.data.location}
          {event.data.mapLink && (
            <a href={event.data.mapLink} target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline font-bold ml-1 hover:text-indigo-800">
              Open Google Maps ↗
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-base mb-8">
      <Content />
    </div>

    {event.data.link && (
      <div class="pt-6 border-t border-slate-200">
        <a href={event.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-xl text-sm shadow-md transition">
          Official Event Page / RSVP →
        </a>
      </div>
    )}
  </article>
</Layout>