---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<Layout title={`${event.data.title} | Vegas Events`}>
  <article class="max-w-3xl mx-auto py-8">
    <a href="/events" class="text-xs font-bold text-slate-500 hover:text-indigo-600 mb-6 inline-flex items-center gap-1">
      ← Back to Events Calendar
    </a>

    {event.data.image && (
      <div class="w-full h-72 sm:h-96 rounded-3xl overflow-hidden bg-slate-100 mb-8 border border-slate-200">
        <img src={event.data.image} alt={event.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
        {event.data.category}
      </span>
      {event.data.admission && (
        <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          {event.data.admission}
        </span>
      )}
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 leading-tight mb-4">
      {event.data.title}
    </h1>

    <div class="bg-slate-100 p-4 rounded-2xl mb-8 space-y-1.5 text-xs text-slate-700 font-medium border border-slate-200">
      <p>📅 <strong>Date & Time:</strong> {event.data.eventDate}</p>
      <p>📍 <strong>Location:</strong> {event.data.location}</p>
    </div>

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-base space-y-4 mb-8">
      <Content />
    </div>

    {event.data.link && (
      <div class="pt-6 border-t border-slate-200">
        <a href={event.data.link} target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-xl text-sm shadow-md transition">
          Official Event Info & Tickets →
        </a>
      </div>
    )}
  </article>
</Layout>