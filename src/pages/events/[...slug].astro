---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(event => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
---

<Layout title={`${event.data.title} | Vegas Events`}>
  <article class="max-w-4xl mx-auto py-8">
    <a href="/events" class="text-xs font-bold text-slate-500 hover:text-indigo-600 mb-6 inline-flex items-center gap-1">
      ← Back to Events Calendar
    </a>

    {event.data.image && (
      <div class="w-full rounded-3xl overflow-hidden bg-slate-100 mb-8 border border-slate-200">
        <img src={event.data.image} alt={event.data.title} class="w-full h-auto max-h-[500px] object-cover" />
      </div>
    )}

    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs font-bold px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
        {event.data.category}
      </span>
      {event.data.admission && (
        <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          {event.data.admission}
        </span>
      )}
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 leading-tight mb-6">
      {event.data.title}
    </h1>

    <!-- Schedule Box -->
    <div class="bg-slate-100 p-6 rounded-2xl border border-slate-200 mb-8">
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">Event Date & Location</h2>
      <div class="space-y-2 text-xs text-slate-700 font-medium">
        {event.data.schedules && event.data.schedules.length > 0 ? (
          event.data.schedules.map((sch: any) => (
            <div class="flex items-center gap-2">
              <span>🗓️</span> <strong>{sch.day || sch.startDateTime || 'Schedule'}:</strong> {sch.timeNote || sch.time || ''}
            </div>
          ))
        ) : (
          <div class="flex items-center gap-2">
            <span>🗓️</span> <strong>Date & Time:</strong> {event.data.eventDate || 'Check Description'}
          </div>
        )}
        <div class="flex items-center gap-2 pt-1">
          <span>📍</span> <strong>Venue:</strong> {event.data.location}
          {event.data.mapLink && (
            <a href={event.data.mapLink} target="_blank" rel="noopener noreferrer" class="text-indigo-600 underline font-bold ml-1">Open Maps ↗</a>
          )}
        </div>
      </div>
    </div>

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed text-base mb-8">
      <Content />
    </div>

    {event.data.link && (
      <div class="pt-6 border-t border-slate-200">
        <a href={event.data.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-black rounded-xl text-sm shadow-md transition">
          Official Event Page / RSVP →
        </a>
      </div>
    )}
  </article>
</Layout>