---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return galleries.map(gallery => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const { Content } = await render(gallery);
---

<Layout title={`${gallery.data.title} | Vegas Photo Gallery`}>
  <article class="max-w-5xl mx-auto py-8">
    <a href="/galleries" class="text-xs font-bold text-slate-500 hover:text-amber-600 mb-6 inline-flex items-center gap-1">
      ← Back to All Galleries
    </a>

    <span class="text-xs font-bold px-3 py-1 rounded-full bg-slate-100 text-slate-700 inline-block mb-3">
      {gallery.data.category}
    </span>

    <h1 class="text-3xl sm:text-5xl font-black text-slate-900 leading-tight mb-4">
      {gallery.data.title}
    </h1>

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed mb-10">
      <Content />
    </div>

    <!-- Photo Masonry Grid -->
    {gallery.data.photos && gallery.data.photos.length > 0 && (
      <div class="border-t border-slate-200 pt-8">
        <h2 class="text-xl font-black text-slate-900 mb-6">Gallery Images</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          {gallery.data.photos.map((item, idx) => (
            <div class="rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 shadow-xs hover:shadow-md transition">
              <a href={item.image} target="_blank" rel="noopener noreferrer">
                <img src={item.image} alt={`Gallery image ${idx + 1}`} class="w-full h-64 object-cover hover:scale-105 transition duration-300" loading="lazy" />
              </a>
            </div>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>