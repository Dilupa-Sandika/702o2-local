---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events')).slice(0, 3);
const deals = (await getCollection('deals')).slice(0, 3);
const galleries = (await getCollection('galleries')).slice(0, 3);
const guides = (await getCollection('guides')).slice(0, 3);
const recipes = (await getCollection('recipes')).slice(0, 3);

const slides = [
  {
    image: "https://images.unsplash.com/photo-1511527661048-7fe73d85e9a4?auto=format&fit=crop&w=1000&q=80",
    badge: "Automotive & Car Meets",
    title: "Classic & Exotic Car Coverage in Las Vegas"
  },
  {
    image: "https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=1000&q=80",
    badge: "Vegas Party Pixies",
    title: "Custom Toddler Birthday & Backdrop Setups"
  },
  {
    image: "https://images.unsplash.com/photo-1533174072545-7a4b6ad7a6c3?auto=format&fit=crop&w=1000&q=80",
    badge: "Local Festivals & Expos",
    title: "Weekend Community Events & Food Festivals"
  }
];
---

<Layout title="702 Local — Events Calendar, Deals & Event Services">
  
  <!-- HERO SECTION WITH PROMO BAR & SLIDER -->
  <section class="py-4 sm:py-8">
    <div class="mb-6 p-3.5 rounded-2xl bg-gradient-to-r from-rose-500 via-pink-500 to-amber-500 text-white flex flex-col sm:flex-row items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-2 text-center sm:text-left">
        <span class="px-2 py-0.5 rounded-md bg-white/20 text-[10px] font-black uppercase tracking-wider">Featured Promo</span>
        <p class="text-xs sm:text-sm font-bold">🎈 Vegas Party Pixies: Complete 15–40 Kids Table & Backdrop Packages from $199</p>
      </div>
      <a href="#parties" class="whitespace-nowrap px-4 py-1.5 bg-white text-rose-600 font-extrabold text-xs rounded-xl hover:bg-slate-50 transition shadow-xs">
        Check Packages →
      </a>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-6 space-y-5 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-xs font-bold text-indigo-800">
          <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
          Las Vegas • Henderson • Summerlin
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.08]">
          Discover Valley Events, <br />
          <span class="bg-gradient-to-r from-indigo-600 via-rose-500 to-amber-500 bg-clip-text text-transparent">
            Local Steals & Celebration Services
          </span>
        </h1>

        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
          Your direct portal for weekly happenings, supermarket savings, boutique toddler party rentals, and event photography across Clark County.
        </p>

        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2">
          <a href="#events" class="px-5 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-xs rounded-xl shadow-md transition">
            Browse Events 📅
          </a>
          <a href="#deals" class="px-5 py-3 bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 font-extrabold text-xs rounded-xl transition">
            Weekly Deals 🏷️
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 relative">
        <div id="carousel" class="relative h-72 sm:h-96 w-full rounded-3xl overflow-hidden border border-slate-200 shadow-xl bg-slate-900">
          {slides.map((slide, index) => (
            <div class={`carousel-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}>
              <img src={slide.image} alt={slide.title} class="w-full h-full object-cover opacity-80" />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/20 to-transparent flex flex-col justify-end p-6">
                <span class="self-start px-3 py-1 rounded-full bg-amber-400 text-slate-950 text-[10px] font-black uppercase tracking-wider mb-2">
                  {slide.badge}
                </span>
                <h3 class="text-white text-lg sm:text-xl font-black">{slide.title}</h3>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: 📅 UPCOMING EVENTS CALENDAR -->
  <section id="events" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900">📅 Upcoming Valley Events</h2>
          <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800">Featured</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Car meets, food festivals, family expos, and free community gatherings.</p>
      </div>
      <a href="/events" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">
        View All Events ({events.length}+) →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {events.map(event => (
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition flex flex-col justify-between group overflow-hidden">
          <div>
            <a href={`/events/${event.id}`}>
              {event.data.image && (
                <div class="h-44 bg-slate-100 overflow-hidden">
                  <img src={event.data.image} alt={event.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                </div>
              )}
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">
                  {event.data.category}
                </span>
                {event.data.admission && (
                  <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                    {event.data.admission}
                  </span>
                )}
              </div>
              <a href={`/events/${event.id}`}>
                <h3 class="text-base font-bold text-slate-900 group-hover:text-indigo-600 transition">{event.data.title}</h3>
              </a>
              {event.data.eventDate && (
                <p class="text-xs text-slate-600 mt-2 font-medium">📅 {event.data.eventDate}</p>
              )}
              <p class="text-xs text-slate-500 mt-1 line-clamp-1">📍 {event.data.location}</p>
            </div>
          </div>
          <div class="p-5 pt-0">
            <a href={`/events/${event.id}`} class="block text-center w-full py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition">
              View Full Details →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 2: 🏷️ VEGAS DEALS & STEALS -->
  <section id="deals" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900">🏷️ Vegas Deals & Steals</h2>
          <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">Weekly Finds</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Supermarkets, local retail markdowns, Walmart, and verified discounts.</p>
      </div>
      <a href="/deals" class="text-xs font-bold text-amber-700 hover:text-amber-900 transition">
        View All Deals →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {deals.map(deal => (
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition overflow-hidden flex flex-col justify-between">
          <div>
            <a href={`/deals/${deal.id}`}>
              {deal.data.image && (
                <div class="h-44 bg-slate-100 overflow-hidden">
                  <img src={deal.data.image} alt={deal.data.title} class="w-full h-full object-cover" />
                </div>
              )}
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[11px] font-bold px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200">
                  {deal.data.store}
                </span>
                {deal.data.price && (
                  <span class="text-xs font-black text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                    {deal.data.price}
                  </span>
                )}
              </div>
              <a href={`/deals/${deal.id}`}>
                <h3 class="text-base font-bold text-slate-900 hover:text-amber-600 transition">{deal.data.title}</h3>
              </a>
              <div class="mt-2 text-xs text-slate-600 leading-relaxed line-clamp-2">{deal.body}</div>
            </div>
          </div>
          <div class="p-5 pt-0 border-t border-slate-100 mt-3">
            <a href={`/deals/${deal.id}`} class="text-xs font-bold text-amber-700 hover:underline">
              View Deal & Circular →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 3: 🖼️ EVENT & AUTO GALLERIES -->
  <section id="galleries" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900">🖼️ Event & Automotive Galleries</h2>
          <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-rose-100 text-rose-800">Photo Sets</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Car meets, toddler birthday setups, and community celebration stills.</p>
      </div>
      <a href="/galleries" class="text-xs font-bold text-rose-600 hover:text-rose-800 transition">
        View All Galleries →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {galleries.map(gallery => (
        <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <a href={`/galleries/${gallery.id}`}>
              <div class="h-44 bg-slate-100 overflow-hidden">
                <img src={gallery.data.coverImage} alt={gallery.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
              </div>
            </a>
            <div class="p-5">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-700">
                {gallery.data.category}
              </span>
              <a href={`/galleries/${gallery.id}`}>
                <h3 class="text-base font-bold text-slate-900 mt-2 group-hover:text-rose-600 transition">{gallery.data.title}</h3>
              </a>
            </div>
          </div>
          <div class="p-5 pt-0 border-t border-slate-100 pt-3">
            <a href={`/galleries/${gallery.id}`} class="text-xs font-bold text-rose-600 hover:underline">
              View Album ({gallery.data.photos?.length || 0} Photos) →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- SECTION 4: 🎈 VEGAS PARTY PIXIES -->
  <section id="parties" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black uppercase tracking-wider text-rose-600">Vegas Party Pixies</span>
      <h2 class="text-3xl font-black text-slate-900 mt-1">🎈 Toddler Birthday Packages & Rentals</h2>
      <p class="text-xs text-slate-500 mt-2">Delivered, styled, and packed away across Las Vegas, Henderson & Summerlin.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-full text-xs font-black">Silver Pixie</span>
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-xl font-black text-slate-900">Sweet & Simple</h3>
            <span class="text-2xl font-black text-rose-600">$199</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-600 font-medium">
            <li>✨ 1 Themed Arched Backdrop</li>
            <li>🎈 6ft Balloon Garland Accent</li>
            <li>🪑 3 Kids Tables + 15-18 Chairs</li>
            <li>🚚 Full Delivery, Setup & Pickup</li>
          </ul>
        </div>
        <a href="/party-rentals#inquiry" class="mt-6 block text-center py-2.5 rounded-xl bg-rose-50 text-rose-700 font-bold text-xs hover:bg-rose-100 transition">
          Book Silver ($199) →
        </a>
      </div>

      <div class="bg-white rounded-3xl border-2 border-rose-500 p-6 shadow-lg flex flex-col justify-between relative">
        <span class="absolute -top-3 right-6 bg-rose-500 text-white px-3 py-0.5 rounded-full text-[10px] font-black uppercase">Most Popular</span>
        <div>
          <span class="bg-rose-50 text-rose-700 px-3 py-1 rounded-full text-xs font-black">Golden Sparkle</span>
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-xl font-black text-slate-900">Toddler Luxe</h3>
            <span class="text-2xl font-black text-rose-600">$299</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-600 font-medium">
            <li>✨ 1 Large Themed Backdrop + Custom Name</li>
            <li>🎈 Full 10ft Organic Luxe Balloon Arch</li>
            <li>🪑 5 Kids Tables + 25-30 Chairs</li>
            <li>🎂 1 Cake / Dessert Plinth Stand</li>
            <li>🚚 Complete Delivery & Teardown</li>
          </ul>
        </div>
        <a href="/party-rentals#inquiry" class="mt-6 block text-center py-2.5 rounded-xl bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 shadow-md transition">
          Book Golden ($299) →
        </a>
      </div>

      <div class="bg-white rounded-3xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between">
        <div>
          <span class="bg-amber-100 text-amber-900 px-3 py-1 rounded-full text-xs font-black">Diamond Magic</span>
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-xl font-black text-slate-900">Grand Setup</h3>
            <span class="text-2xl font-black text-rose-600">$449</span>
          </div>
          <ul class="space-y-2 text-xs text-slate-600 font-medium">
            <li>✨ Multi-Panel Backdrop Set + Neon Light</li>
            <li>🎈 Double Organic Balloon Arch</li>
            <li>🪑 7-8 Tables + 35-40 Chairs + Covers</li>
            <li>🎂 Complete 3-Piece Plinth Set</li>
          </ul>
        </div>
        <a href="/party-rentals#inquiry" class="mt-6 block text-center py-2.5 rounded-xl bg-slate-900 text-white font-bold text-xs hover:bg-slate-800 transition">
          Book Diamond ($449) →
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 5: 📸 EVENT & AUTO PHOTOGRAPHY -->
  <section id="media" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-black uppercase tracking-wider text-slate-700">702 Local Media</span>
      <h2 class="text-3xl font-black text-slate-900 mt-1">📸 Event & Auto Photography Coverage</h2>
      <p class="text-xs text-slate-500 mt-2">Professional high-res photography and 4K social reels for car meets and celebrations.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
      <div class="bg-white p-7 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-baseline mb-2">
            <h3 class="text-xl font-black text-slate-900">2-Hour Event Coverage</h3>
            <span class="text-2xl font-black text-slate-900">$199</span>
          </div>
          <p class="text-xs text-slate-500 mb-4">40+ edited high-res digital photos, fast 48-hour delivery. ($100/additional hr).</p>
        </div>
        <a href="/media#booking" class="block text-center py-2.5 bg-slate-900 text-white text-xs font-bold rounded-xl hover:bg-slate-800 transition">
          Book 2-Hour Shoot ($199) →
        </a>
      </div>

      <div class="bg-white p-7 rounded-3xl border-2 border-amber-500 shadow-md flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-baseline mb-2">
            <h3 class="text-xl font-black text-slate-900">4-Hour Half-Day / Car Feature</h3>
            <span class="text-2xl font-black text-amber-600">$379</span>
          </div>
          <p class="text-xs text-slate-500 mb-4">100+ edited photos, 2 vertical 4K highlight reels, full commercial usage rights.</p>
        </div>
        <a href="/media#booking" class="block text-center py-2.5 bg-amber-500 text-slate-950 text-xs font-black rounded-xl hover:bg-amber-400 transition">
          Book Half-Day ($379) →
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 6: 📖 LOCAL VEGAS GUIDES -->
  <section id="guides" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900">📖 Vegas Local Guides</h2>
          <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Best-of Vegas</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Curated local recommendations, food discoveries, and consumer reports.</p>
      </div>
      <a href="/guides" class="text-xs font-bold text-emerald-700 hover:text-emerald-900 transition">
        View All Guides →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {guides.map(guide => (
        <article class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <a href={`/guides/${guide.id}`}>
              {guide.data.image && (
                <div class="h-44 bg-slate-100 overflow-hidden">
                  <img src={guide.data.image} alt={guide.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                </div>
              )}
            </a>
            <div class="p-5">
              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                {guide.data.category}
              </span>
              <a href={`/guides/${guide.id}`}>
                <h3 class="text-base font-bold text-slate-900 mt-2 hover:text-emerald-600 transition line-clamp-2">{guide.data.title}</h3>
              </a>
              <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">{guide.data.excerpt}</p>
            </div>
          </div>
          <div class="p-5 pt-0 border-t border-slate-100 pt-3">
            <a href={`/guides/${guide.id}`} class="text-xs font-bold text-emerald-600 hover:underline">
              Read Full Guide →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- SECTION 7: 🍳 RECIPES & KITCHEN HACKS -->
  <section id="recipes" class="py-12 border-t border-slate-200 scroll-mt-20">
    <div class="flex items-center justify-between pb-6 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-black text-slate-900">🍳 Budget Recipes & Kitchen Hacks</h2>
          <span class="text-xs font-black px-2.5 py-0.5 rounded-full bg-orange-100 text-orange-800">Under $10</span>
        </div>
        <p class="text-xs text-slate-500 mt-1">Quick meals made from weekly valley supermarket deals.</p>
      </div>
      <a href="/recipes" class="text-xs font-bold text-orange-700 hover:text-orange-900 transition">
        View All Recipes →
      </a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {recipes.map(recipe => (
        <div class="bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <a href={`/recipes/${recipe.id}`}>
              {recipe.data.image && (
                <div class="h-44 bg-slate-100 overflow-hidden">
                  <img src={recipe.data.image} alt={recipe.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                </div>
              )}
            </a>
            <div class="p-5">
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full">
                  ⏱️ {recipe.data.time}
                </span>
                {recipe.data.cost && (
                  <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                    💰 {recipe.data.cost}
                  </span>
                )}
              </div>
              <a href={`/recipes/${recipe.id}`}>
                <h3 class="text-base font-bold text-slate-900 hover:text-orange-600 transition line-clamp-1">{recipe.data.title}</h3>
              </a>
              <div class="mt-2 text-xs text-slate-600 line-clamp-2">{recipe.body}</div>
            </div>
          </div>
          <div class="p-5 pt-0 border-t border-slate-100 pt-3">
            <a href={`/recipes/${recipe.id}`} class="text-xs font-bold text-orange-600 hover:underline">
              View Ingredients & Steps →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

</Layout>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.carousel-slide');
  if (slides.length > 0) {
    setInterval(() => {
      slides[currentSlide].classList.remove('opacity-100');
      slides[currentSlide].classList.add('opacity-0', 'pointer-events-none');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.remove('opacity-0', 'pointer-events-none');
      slides[currentSlide].classList.add('opacity-100');
    }, 4000);
  }
</script>