---
import Layout from '../layouts/Layout.astro';
---

<Layout title="702 Local Media — Event Photography & Auto Coverage">
  
  <section class="text-center pt-4 pb-10">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 border border-slate-300 text-xs font-bold text-slate-800 mb-6">
      <span>📸</span> 702 Local Media & Photography
    </div>

    <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto">
      Event Coverage & <br />
      <span class="bg-gradient-to-r from-amber-500 via-rose-500 to-indigo-600 bg-clip-text text-transparent">
        Automotive Photography
      </span>
    </h1>

    <p class="text-slate-600 max-w-2xl mx-auto text-base sm:text-lg mt-5 leading-relaxed">
      Independent Las Vegas digital media covering automotive culture, luxury expos, private celebrations, and local businesses.
    </p>
  </section>

  <!-- Pricing Packages Grid -->
  <section class="py-8 border-t border-slate-200">
    <div class="text-center max-w-xl mx-auto mb-10">
      <h2 class="text-2xl font-black text-slate-900">Event Photography Packages</h2>
      <p class="text-xs text-slate-500 mt-1">Available for car shows, kids birthdays, private gatherings, and business launches.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      
      <!-- Package 1: 2-Hour Starter -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm hover:shadow-xl transition flex flex-col justify-between">
        <div>
          <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-full text-xs font-black">Starter Coverage</span>
          <div class="flex justify-between items-baseline my-4">
            <h3 class="text-2xl font-black text-slate-900">2-Hour Event Shoot</h3>
            <span class="text-3xl font-black text-slate-900">$199</span>
          </div>
          <p class="text-xs text-slate-500 mb-6 font-medium">Ideal for 1st/2nd birthday celebrations, private dinners, and mini car meets.</p>
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2"><span>📷</span> Up to 2 Hours of On-Site Shooting</li>
            <li class="flex items-center gap-2"><span>🖼️</span> 40+ High-Resolution Edited Digital Photos</li>
            <li class="flex items-center gap-2"><span>⚡</span> Fast 48-Hour Cloud Gallery Delivery</li>
            <li class="flex items-center gap-2"><span>➕</span> Additional Hours: $100/hr</li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#booking" class="block text-center w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl transition">
            Book 2-Hour Shoot ($199) →
          </a>
        </div>
      </div>

      <!-- Package 2: Half-Day / Car & Expo Feature -->
      <div class="bg-white rounded-3xl border-2 border-amber-500 p-8 shadow-md hover:shadow-xl transition flex flex-col justify-between relative">
        <div class="absolute -top-3 right-6 bg-amber-500 text-slate-950 px-3 py-0.5 rounded-full text-xs font-black uppercase">
          Best Value
        </div>
        <div>
          <span class="bg-amber-50 text-amber-800 px-3 py-1 rounded-full text-xs font-black">Full Coverage</span>
          <div class="flex justify-between items-baseline my-4">
            <h3 class="text-2xl font-black text-slate-900">4-Hour Half-Day Shoot</h3>
            <span class="text-3xl font-black text-amber-600">$379</span>
          </div>
          <p class="text-xs text-slate-500 mb-6 font-medium">Comprehensive coverage for major events, car expos, and grand parties.</p>
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2"><span>📷</span> Up to 4 Hours of Dedicated Coverage</li>
            <li class="flex items-center gap-2"><span>🖼️</span> 100+ High-Resolution Edited Photos</li>
            <li class="flex items-center gap-2"><span>🎥</span> 2 Vertical 4K Social Highlight Reels (Reels/TikTok)</li>
            <li class="flex items-center gap-2"><span>⚡</span> 24-Hour Sneak Peek + Full Gallery in 72 Hours</li>
          </ul>
        </div>
        <div class="mt-8">
          <a href="#booking" class="block text-center w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs rounded-xl shadow-xs transition">
            Book Half-Day ($379) →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Editorial & Press Credentials Kit (For Wynn / Auto Shows) -->
  <section class="py-10 max-w-4xl mx-auto">
    <div class="bg-slate-900 text-white p-8 rounded-3xl border border-slate-800 space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-xl font-bold text-amber-400">Media Credentials & Press Inquiries</h3>
        <span class="text-xs bg-slate-800 px-3 py-1 rounded-full text-slate-400 font-mono">ID: 702O2-MEDIA</span>
      </div>
      <p class="text-xs text-slate-300 leading-relaxed">
        702 Local operates as an accredited digital outlet for Las Vegas automotive lifestyle, luxury expos, and community affairs. We provide 4K cinematic reels, technical vehicle detail coverage, and digital distribution.
      </p>
      <div class="grid sm:grid-cols-2 gap-3 text-xs text-slate-400 pt-2 border-t border-slate-800">
        <div>📍 <strong>Market:</strong> Las Vegas / Clark County, NV</div>
        <div>✉️ <strong>Press Contact:</strong> media@702o2.com</div>
      </div>
    </div>
  </section>

  <!-- Photography Booking Form -->
  <section id="booking" class="py-10 border-t border-slate-200">
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-3xl border border-slate-200 shadow-lg">
      <div class="text-center mb-6">
        <h3 class="text-2xl font-black text-slate-900">Book a Shoot / Check Date</h3>
        <p class="text-xs text-slate-500 mt-1">Leave your details and shoot requirements. We'll confirm availability promptly.</p>
      </div>

      <form name="media-booking" method="POST" data-netlify="true" class="space-y-4">
        <input type="hidden" name="form-name" value="media-booking" />
        
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Your Name *</label>
          <input type="text" name="name" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm" placeholder="e.g. Michael Davis" />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Phone Number *</label>
            <input type="tel" name="phone" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm" placeholder="(702) 000-0000" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Shoot Date *</label>
            <input type="date" name="shootDate" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-700" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Coverage Type *</label>
          <select name="service" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm">
            <option value="2-Hour Starter ($199)">2-Hour Starter Shoot ($199)</option>
            <option value="4-Hour Half-Day ($379)">4-Hour Half-Day Shoot ($379)</option>
            <option value="Vehicle / Car Shoot">Individual Vehicle Photoshoot</option>
            <option value="Media Press Inquiry">Media / Press Coverage Inquiry</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Event Location / Details</label>
          <textarea name="details" rows="3" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm" placeholder="Location, event type, number of hours needed..."></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-black rounded-xl text-sm shadow-md transition">
          Submit Shoot Request 📸
        </button>
      </form>
    </div>
  </section>

</Layout>