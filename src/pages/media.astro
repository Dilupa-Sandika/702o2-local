---
import Layout from '../layouts/Layout.astro';
---

<Layout title="702 Local Media — Event & Celebration Photography">
  <section class="text-center pt-4 pb-10">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-100 border border-slate-200 text-xs font-bold text-slate-800 mb-6">
      <span>📸</span> High-Res Stills + 4K Social Reels
    </div>

    <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto">
      Celebration & Event <br />
      <span class="bg-gradient-to-r from-amber-500 via-orange-500 to-rose-500 bg-clip-text text-transparent">
        Photography Coverage
      </span>
    </h1>

    <p class="text-slate-600 max-w-2xl mx-auto text-base sm:text-lg mt-5 leading-relaxed">
      Crisp high-resolution digital coverage and vertical social media reels for private birthdays, family parties, corporate expos, and community gatherings across Las Vegas.
    </p>
  </section>

  <section class="py-8 border-t border-slate-200">
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-baseline mb-4">
            <h3 class="text-2xl font-black text-slate-900">2-Hour Event Coverage</h3>
            <span class="text-3xl font-black text-slate-900">$199</span>
          </div>
          <p class="text-xs text-slate-500 mb-6">Perfect for birthday parties, family celebrations, and local pop-ups.</p>
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li>📸 40+ Color-Graded High-Res Photos</li>
            <li>⚡ Fast 48-Hour Cloud Gallery Delivery</li>
            <li>🔒 Full Personal & Social Sharing License</li>
            <li>⏱️ $100 / Additional hour on request</li>
          </ul>
        </div>
        <a href="#booking" class="mt-8 block text-center py-3 bg-slate-900 text-white text-xs font-bold rounded-xl hover:bg-slate-800 transition">
          Book 2-Hour Shoot ($199) →
        </a>
      </div>

      <div class="bg-white p-8 rounded-3xl border-2 border-amber-500 shadow-lg flex flex-col justify-between">
        <div>
          <div class="flex justify-between items-baseline mb-4">
            <h3 class="text-2xl font-black text-slate-900">4-Hour Half-Day Coverage</h3>
            <span class="text-3xl font-black text-amber-600">$379</span>
          </div>
          <p class="text-xs text-slate-500 mb-6">Comprehensive photo + video reel package for major milestones and multi-hour events.</p>
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li>📸 100+ Master Color-Graded Photos</li>
            <li>🎬 2 Vertical 4K Social Highlight Reels</li>
            <li>⚡ 72-Hour Turnaround with Full Commercial Rights</li>
          </ul>
        </div>
        <a href="#booking" class="mt-8 block text-center py-3 bg-amber-500 text-slate-950 text-xs font-black rounded-xl hover:bg-amber-400 transition shadow-md">
          Book Half-Day ($379) →
        </a>
      </div>
    </div>
  </section>

  <!-- Booking Form -->
  <section id="booking" class="py-16 max-w-2xl mx-auto border-t border-slate-200">
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-md">
      <h2 class="text-2xl font-black text-slate-900 text-center mb-2">Book Event Media Coverage</h2>
      <p class="text-xs text-slate-500 text-center mb-8">Tell us about your event date and details.</p>

      <form name="media-booking" method="POST" data-netlify="true" class="space-y-4">
        <input type="hidden" name="form-name" value="media-booking" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Your Name</label>
            <input type="text" name="name" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Phone Number</label>
            <input type="tel" name="phone" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Email Address</label>
          <input type="email" name="email" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Event Date</label>
            <input type="date" name="shoot-date" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Package</label>
            <select name="package" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none">
              <option value="2-Hour Coverage ($199)">2-Hour Coverage ($199)</option>
              <option value="4-Hour Half-Day ($379)">4-Hour Half-Day Coverage ($379)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Event Details / Venue</label>
          <textarea name="details" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" placeholder="e.g. 5th birthday celebration in Summerlin, community gathering..."></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-black text-sm rounded-xl shadow-md transition">
          Submit Booking Request 📸
        </button>
      </form>
    </div>
  </section>
</Layout>