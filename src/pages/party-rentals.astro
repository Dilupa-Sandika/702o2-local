---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vegas Party Pixies — Toddler Birthday Party & Table/Chair Rentals">
  
  <section class="text-center pt-4 pb-10">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-rose-50 border border-rose-200 text-xs font-bold text-rose-800 mb-6">
      <span>🧚‍♀️</span> Vegas Party Pixies • Luxury Toddler Birthday Setups
    </div>

    <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto">
      Magical Birthday Setups <br />
      <span class="bg-gradient-to-r from-rose-500 via-pink-500 to-amber-500 bg-clip-text text-transparent">
        Made Easy & Affordable
      </span>
    </h1>

    <p class="text-slate-600 max-w-2xl mx-auto text-base sm:text-lg mt-5 leading-relaxed">
      Custom backdrops, balloon styling, and complete kids table & chair rentals delivered, set up, and packed away across Las Vegas, Henderson & Summerlin.
    </p>
  </section>

  <!-- Pricing Cards Section -->
  <section id="packages" class="py-8 border-t border-slate-200">
    <div class="grid md:grid-cols-3 gap-8">
      
      <!-- Package 1: $199 -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="p-6">
          <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-full text-xs font-black">Sweet & Simple</span>
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-2xl font-black text-slate-900">Silver Pixie</h3>
            <span class="text-3xl font-black text-rose-600">$199</span>
          </div>
          <p class="text-xs text-slate-500 mb-6 font-medium">Ideal for intimate home / backyard birthday gatherings (~15 kids).</p>
          
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2"><span>✨</span> 1 Themed Arched / Round Backdrop</li>
            <li class="flex items-center gap-2"><span>🎈</span> 6ft Mini Balloon Garland Accent</li>
            <li class="flex items-center gap-2 font-bold text-slate-900"><span>🪑</span> 3 Kids Tables + 15-18 Chairs Included</li>
            <li class="flex items-center gap-2"><span>🚚</span> On-Time Delivery, Setup & Teardown</li>
          </ul>
        </div>
        <div class="p-6 pt-0">
          <a href="#inquiry" class="block text-center w-full py-3 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 font-bold text-xs border border-rose-200 transition">
            Book Silver ($199) →
          </a>
        </div>
      </div>

      <!-- Package 2: $299 (Featured) -->
      <div class="bg-white rounded-3xl border-2 border-rose-500 shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden flex flex-col justify-between relative">
        <div class="bg-gradient-to-r from-rose-500 to-amber-500 text-white text-center py-1.5 text-xs font-black tracking-wider uppercase">
          ⭐ Most Popular Choice
        </div>
        <div class="p-6">
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-2xl font-black text-slate-900">Golden Sparkle</h3>
            <span class="text-3xl font-black text-rose-600">$299</span>
          </div>
          <p class="text-xs text-slate-500 mb-6 font-medium">Our bestselling package for 1st, 2nd, and 3rd toddler birthdays (~25-30 kids).</p>
          
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2"><span>✨</span> 1 Large Themed Backdrop + Custom Name Sign</li>
            <li class="flex items-center gap-2"><span>🎈</span> Full 10ft Organic Luxe Balloon Arch</li>
            <li class="flex items-center gap-2 font-bold text-slate-900"><span>🪑</span> 5 Kids Tables + 25-30 Chairs Included</li>
            <li class="flex items-center gap-2"><span>🎂</span> 1 Matching Cake / Dessert Cylinder Plinth</li>
            <li class="flex items-center gap-2"><span>🚚</span> Full Setup & Next-Day / Evening Pickup</li>
          </ul>
        </div>
        <div class="p-6 pt-0">
          <a href="#inquiry" class="block text-center w-full py-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-md transition">
            Book Golden ($299) →
          </a>
        </div>
      </div>

      <!-- Package 3: $449 -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
        <div class="p-6">
          <span class="bg-amber-100 text-amber-900 px-3 py-1 rounded-full text-xs font-black">Grand Celebration</span>
          <div class="flex justify-between items-baseline my-3">
            <h3 class="text-2xl font-black text-slate-900">Diamond Magic</h3>
            <span class="text-3xl font-black text-rose-600">$449</span>
          </div>
          <p class="text-xs text-slate-500 mb-6 font-medium">Complete deluxe party setup for larger family & neighborhood events (35+ kids).</p>
          
          <ul class="space-y-3 text-xs text-slate-700 font-medium">
            <li class="flex items-center gap-2"><span>✨</span> Multi-Panel Backdrop Set + Neon Lighting</li>
            <li class="flex items-center gap-2"><span>🎈</span> Mega Double Balloon Arch / Wall Installation</li>
            <li class="flex items-center gap-2 font-bold text-slate-900"><span>🪑</span> 7-8 Tables + 35-40 Chairs + Table Covers</li>
            <li class="flex items-center gap-2"><span>🎂</span> Full 3-Piece Dessert Plinth Stand Set</li>
            <li class="flex items-center gap-2"><span>📸</span> Vendor Coordination (Photo/Catering Referral)</li>
          </ul>
        </div>
        <div class="p-6 pt-0">
          <a href="#inquiry" class="block text-center w-full py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs shadow-md transition">
            Book Diamond ($449) →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Netlify Form Section -->
  <section id="inquiry" class="py-12 border-t border-slate-200">
    <div class="max-w-2xl mx-auto bg-white p-8 sm:p-10 rounded-3xl border border-slate-200 shadow-lg">
      <div class="text-center mb-8">
        <span class="text-xs font-black uppercase tracking-wider text-rose-600">Reserve Your Date</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Book / Inquire Availability</h2>
        <p class="text-xs text-slate-500 mt-2">Submit your event date and details. We will confirm date availability and send a quote within 2 hours!</p>
      </div>

      <form name="party-inquiry" method="POST" data-netlify="true" class="space-y-4">
        <input type="hidden" name="form-name" value="party-inquiry" />

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Parent's Full Name *</label>
          <input type="text" name="name" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" placeholder="e.g. Amanda Smith" />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Phone Number (For Fast Text) *</label>
            <input type="tel" name="phone" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" placeholder="(702) 000-0000" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address *</label>
            <input type="email" name="email" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" placeholder="name@email.com" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Desired Event Date *</label>
            <input type="date" name="eventDate" required class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 text-slate-700" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Selected Package *</label>
            <select name="package" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 text-slate-700">
              <option value="Golden Sparkle ($299)">Golden Sparkle ($299) - Most Popular</option>
              <option value="Silver Pixie ($199)">Silver Pixie ($199)</option>
              <option value="Diamond Magic ($449)">Diamond Magic ($449)</option>
              <option value="Custom Table & Chair Setup">Custom Table & Chair Setup Only</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">Party Theme or Notes (Location / Special Requests)</label>
          <textarea name="notes" rows="3" class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-rose-500" placeholder="e.g. 1st Birthday Boho Theme in Summerlin..."></textarea>
        </div>

        <button type="submit" class="w-full py-3.5 bg-rose-600 hover:bg-rose-700 text-white font-extrabold rounded-xl text-sm shadow-md transition">
          Submit Inquiry / Check Date ✨
        </button>
      </form>
    </div>
  </section>

</Layout>