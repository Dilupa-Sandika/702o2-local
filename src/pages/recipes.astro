---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
---

<Layout title="Budget Recipes & Quick Meal Hacks — 702 Local">
  <section class="text-center pt-4 pb-10">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-orange-50 border border-orange-200 text-xs font-bold text-orange-800 mb-6">
      <span>🍳</span> Family Meals Under $10
    </div>

    <h1 class="text-4xl sm:text-6xl font-black text-slate-900 tracking-tight leading-[1.1] max-w-4xl mx-auto">
      Budget Kitchen Hacks & <br />
      <span class="bg-gradient-to-r from-orange-500 via-amber-500 to-rose-500 bg-clip-text text-transparent">
        Quick Grocery Recipes
      </span>
    </h1>

    <p class="text-slate-600 max-w-2xl mx-auto text-base sm:text-lg mt-5 leading-relaxed">
      Turn your local supermarket steals into fast, delicious family meals. Budget-tested and easy to prepare.
    </p>
  </section>

  <!-- Recipes Grid with Clickable Cards -->
  <section class="py-8 border-t border-slate-200">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {recipes.map(recipe => (
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group">
          <div>
            <a href={`/recipes/${recipe.id}`}>
              {recipe.data.image && (
                <div class="h-48 overflow-hidden bg-slate-100">
                  <img src={recipe.data.image} alt={recipe.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                </div>
              )}
            </a>
            <div class="p-6">
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-bold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full">
                  ⏱️ {recipe.data.time}
                </span>
                {recipe.data.cost && (
                  <span class="text-xs font-black text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                    💰 {recipe.data.cost}
                  </span>
                )}
              </div>
              <a href={`/recipes/${recipe.id}`}>
                <h3 class="text-xl font-bold text-slate-900 group-hover:text-orange-600 transition">
                  {recipe.data.title}
                </h3>
              </a>
              <div class="mt-4 text-xs text-slate-600 leading-relaxed line-clamp-2 border-t border-slate-100 pt-3">
                {recipe.body}
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={`/recipes/${recipe.id}`} class="block text-center w-full py-2 text-xs font-bold text-orange-600 bg-orange-50 hover:bg-orange-100 rounded-xl transition">
              View Ingredients & Steps →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>